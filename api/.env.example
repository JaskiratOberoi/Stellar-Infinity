# Noble (the shared LIS MS SQL Server) — copy to .env and fill in.
# NEVER commit the real .env. Passwords live only in gitignored env files.
#
# Env vars map onto appsettings via the double-underscore separator:
#   Noble__Server  ->  { "Noble": { "Server": ... } }

Noble__Server=10.0.0.10,1433
Noble__Database=Noble
Noble__User=nobleone
Noble__Password=

# TLS. Prefer HostNameInCertificate over TrustServerCertificate when the server
# is reached by bare IP but presents a certificate for a hostname.
Noble__Encrypt=true
Noble__TrustServerCertificate=false
# Noble__HostNameInCertificate=sqlserver

# Shows up in sys.dm_exec_sessions — keep it distinct from Telo's "TeloApp"
# so Infinity's load on the shared server is attributable.
Noble__ApplicationName=InfinityApi

Noble__ConnectTimeoutSeconds=15
Noble__CommandTimeoutSeconds=45
Noble__WriteCommandTimeoutSeconds=120

# Hard cap on concurrent connections to Noble. This is a SHARED PRODUCTION
# database also serving the live LIS — hundreds of concurrent API users must not
# become hundreds of SQL connections. Raise this only with evidence.
Noble__MaxPoolSize=20
Noble__MinPoolSize=0

# JWT signing. Generate a fresh one — this is the only thing between a stranger
# and a forged super_admin token:
#   openssl rand -base64 48
Jwt__Secret=
Jwt__Issuer=infinity-api
Jwt__Audience=infinity-web
Jwt__LifetimeMinutes=480

ASPNETCORE_URLS=http://0.0.0.0:8080
