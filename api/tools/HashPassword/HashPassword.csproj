<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Infinity.HashPassword</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked, not copied: the tool must produce a digest with byte-identical
         parameters to the one the API verifies against. A second implementation
         that drifted by one iteration count would silently emit hashes that
         never validate. -->
    <Compile Include="../../src/Infinity.Api/Worksheet/PasswordHash.cs" Link="PasswordHash.cs" />
  </ItemGroup>

</Project>
