<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Infinity.Api</RootNamespace>
    <!-- Do NOT set InvariantGlobalization=true here. It looks like free savings
         (NobleTime uses a fixed +05:30 offset and never needs the ICU timezone
         database), but Microsoft.Data.SqlClient throws
         "Globalization Invariant Mode is not supported" on every Open(). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Smart Report knowledge base, generated from Telo's smartMeta.ts by
         tools/smartmeta-export.mjs. Embedded so the API has no runtime file
         dependency and the content ships with the binary. -->
    <EmbeddedResource Include="Resources\smart-meta.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <!-- Required by Caching/InfinityCache.cs. The cache degrades to the
         in-process path when Redis is not configured, so this reference is
         needed to COMPILE even in a deployment that never connects to Redis. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- The QR on the printed report (Reports/ReportLink.cs). PngByteQRCode is
         pure managed — no System.Drawing, so nothing native to install in the
         container. Taken as a dependency rather than written because a QR
         encoder is Reed-Solomon error correction and mask selection, and a
         subtly wrong one produces a code that scans on the phone you tested
         with and fails on a patient's. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="MailKit" Version="4.8.0" />
  </ItemGroup>

</Project>
